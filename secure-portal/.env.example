NODE_ENV=development
PORT=4100
PUBLIC_ORIGIN=http://localhost:4100
D1_BINDING_ORIGIN=http://d1:8788
SERVE_STATIC=true
REDIS_URL=redis://redis:6379

# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SESSION_PEPPER=replace-with-at-least-32-random-characters

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
PASSWORD_RESET_MINUTES=30
INVITATION_EXPIRY_HOURS=72

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Bitwise Secure Portal <portal@bitwise-security.nl>
EMAIL_PROVIDER=smtp
RESEND_API_KEY=

STORAGE_MODE=local
LOCAL_STORAGE_PATH=./data/private-files
FILE_KEY_PROVIDER=local
FILE_KEY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SCANNER_MODE=stub
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MAX_FILE_SIZE_BYTES=2147483648
UPLOAD_CHUNK_SIZE_BYTES=8388608

# Production S3/R2 and KMS settings; leave unset for local development.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AWS_KMS_KEY_ID=

# Development seed values only. Never reuse these in production.
SEED_ADMIN_EMAIL=admin@bitwise-security.local
SEED_ADMIN_PASSWORD=Development-Admin-Password-2026!
SEED_CLIENT_PASSWORD=Development-Client-Password-2026!
SEED_TOTP_SECRET=JBSWY3DPEHPK3PXP
