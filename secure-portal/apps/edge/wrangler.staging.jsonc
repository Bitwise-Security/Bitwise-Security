{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "6931a6facc4105d469f43215d2c3fb23",
  "name": "bitwise-secure-portal-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "portal-test.bitwise-security.nl",
      "custom_domain": true
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://portal-test.bitwise-security.nl",
    "DEPLOYMENT_ENVIRONMENT": "staging",
    "EMAIL_FROM": "Bitwise Secure Portal <portal@bitwise-security.nl>"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "PORTAL_FILES",
      "bucket_name": "bitwise-secure-portal-staging-files"
    }
  ],
  "d1_databases": [
    {
      "binding": "PORTAL_DB",
      "database_name": "bitwise-secure-portal-staging-db",
      "database_id": "2751c532-68f9-4ffc-988e-bb7e3afaf935",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PORTAL_CONTAINER",
        "class_name": "PortalContainer"
      },
      {
        "name": "AUTH_RATE_LIMITER",
        "class_name": "AuthRateLimiter"
      }
    ]
  },
  "containers": [
    {
      "class_name": "PortalContainer",
      "image": "../../Dockerfile.cloudflare",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PortalContainer", "AuthRateLimiter"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "limits": {
    "cpu_ms": 300000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
